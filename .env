# Exact, fixed destination URL. Not supplied by visitors.
DEST_URL=https://destination.example.com/

# From Cloudflare Dashboard > Turnstile
TURNSTILE_SITE_KEY=replace_with_public_site_key
TURNSTILE_SECRET=replace_with_private_secret

# Telegram: @BotFather bot token, and your chat/group ID
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id
